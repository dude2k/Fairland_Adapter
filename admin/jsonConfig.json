{
  "type": "panel",
  "i18n": true,
  "items": {
    "accountName": {
      "type": "text",
      "label": "iGarden account e-mail",
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6,
      "newLine": true
    },
    "password": {
      "type": "password",
      "label": "iGarden password",
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "loginCountry": {
      "type": "select",
      "label": "Login country",
      "help": "Select the country code used for iGarden login. Leave Automatic if your account works without a country code.",
      "options": [
        {
          "label": "Automatic",
          "value": ""
        },
        {
          "label": "Austria (+43)",
          "value": "AT"
        },
        {
          "label": "Switzerland (+41)",
          "value": "CH"
        },
        {
          "label": "China (+86)",
          "value": "CN"
        },
        {
          "label": "Germany (+49)",
          "value": "DE"
        },
        {
          "label": "Spain (+34)",
          "value": "ES"
        },
        {
          "label": "France (+33)",
          "value": "FR"
        },
        {
          "label": "United Kingdom (+44)",
          "value": "GB"
        },
        {
          "label": "Hong Kong (+852)",
          "value": "HK"
        },
        {
          "label": "Italy (+39)",
          "value": "IT"
        },
        {
          "label": "Netherlands (+31)",
          "value": "NL"
        },
        {
          "label": "Poland (+48)",
          "value": "PL"
        },
        {
          "label": "Portugal (+351)",
          "value": "PT"
        },
        {
          "label": "United States (+1)",
          "value": "US"
        }
      ],
      "default": "",
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6,
      "newLine": true
    },
    "scanInterval": {
      "type": "number",
      "label": "Scan interval in seconds",
      "min": 10,
      "max": 3600,
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6,
      "default": 30,
      "newLine": true
    },
    "courtyardId": {
      "type": "text",
      "label": "Courtyard ID (optional)",
      "help": "Leave empty to use the first courtyard returned by the iGarden cloud. If you have several courtyards, set the desired ID from the adapter log.",
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "createRawStates": {
      "type": "checkbox",
      "label": "Create raw dpId states",
      "help": "Creates raw states under devices.<device>.raw.dp_<id>. Writable raw states follow the cloud dpMode and are useful for diagnostics.",
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6,
      "newLine": true
    }
  }
}
